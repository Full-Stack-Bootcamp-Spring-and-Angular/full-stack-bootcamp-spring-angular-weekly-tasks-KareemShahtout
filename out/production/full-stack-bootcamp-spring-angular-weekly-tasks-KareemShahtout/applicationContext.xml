<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans.xsd
    http://www.springframework.org/schema/context
    http://www.springframework.org/schema/context/spring-context.xsd">

    <context:component-scan base-package="com.beanScope"/>

    <bean id="draw2dBean" class="com.beanScope.Draw.Draw2d"/>

    <bean id="draw3dBean" class="com.beanScope.Draw.Draw3d"/>

    <bean id="circleBean" class="com.beanScope.Shape.Circle" scope="singleton">
        <constructor-arg ref="draw2dBean"/>
    </bean>
    <bean id="squareBean" class="com.beanScope.Shape.Square" scope="prototype">
        <property name="drawStrategy" ref="draw3dBean"/>
    </bean>

    <bean id="databaseBean" class="com.beanScope.DatabaseOperations"
          scope="singleton"
          init-method="connectToDatabase"
          destroy-method="disconnectFromDatabase"/>
</beans>